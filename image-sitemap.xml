---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{% for entry in site.data.page_images %}
  <url>
    <loc>{{ entry[0] | absolute_url | xml_escape }}</loc>
    {% for image in entry[1] %}
    <image:image><image:loc>{{ image.contentUrl | xml_escape }}</image:loc></image:image>
    {% endfor %}
  </url>
{% endfor %}
</urlset>
